DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landslide_ews
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Citizen-report photo storage (Supabase Storage). Optional -- the app runs
# fine without these, but POST /reports will 500 on any request that
# includes a photo until they're set. Get these from the same Supabase
# project as DATABASE_URL: Project Settings -> API for the URL and the
# service_role key (NOT the anon/public key -- service_role is needed to
# write to storage server-side). Create the bucket named below in
# Storage -> New bucket, marked Public (so photo_url is directly viewable).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=citizen-reports

# Rainfall intensity-duration threshold — required, no code default.
# The values below are our current best-known source, NOT verified against
# the primary text (it's paywalled). Confirm against the actual paper before
# using in a live demo; replace this whole block if the team finds/verifies
# a different source.
#
# Source: Harilal, G.T., Madhu, D., Ramesh, M.V. & Pullarkatt, D. (2019).
# "Towards establishing rainfall thresholds for a real-time landslide early
# warning system in Sikkim, India." Landslides, 16(12), 2395-2408.
# DOI: 10.1007/s10346-019-01244-1
RAINFALL_THRESHOLD__REGION=Sikkim (regional)
RAINFALL_THRESHOLD__EQUATION_TYPE=power_law_intensity_duration
RAINFALL_THRESHOLD__COEFFICIENT=43.26
RAINFALL_THRESHOLD__EXPONENT=-0.78
RAINFALL_THRESHOLD__DURATION_UNIT=days
RAINFALL_THRESHOLD__INTENSITY_UNIT=mm/day
RAINFALL_THRESHOLD__DURATIONS_DAYS=[1,3,5,7,10,15,20]
RAINFALL_THRESHOLD__SOURCE=Harilal, Madhu, Ramesh & Pullarkatt (2019), Landslides 16(12), 2395-2408
RAINFALL_THRESHOLD__SOURCE_DOI=10.1007/s10346-019-01244-1
RAINFALL_THRESHOLD__VERIFIED_AGAINST_PRIMARY_TEXT=false
