DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landslide_ews
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Citizen-report photo storage (Supabase Storage). Optional -- the app runs
# fine without these, but POST /reports will 500 on any request that
# includes a photo until they're set. Get these from the same Supabase
# project as DATABASE_URL: Project Settings -> API for the URL and the
# service_role key (NOT the anon/public key -- service_role is needed to
# write to storage server-side). Create the bucket named below in
# Storage -> New bucket, marked Public (so photo_url is directly viewable).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=citizen-reports

# Rainfall intensity-duration threshold — required, no code default.
# The values below are our current best-known source, NOT verified against
# the primary text (it's paywalled). Confirm against the actual paper before
# using in a live demo; replace this whole block if the team finds/verifies
# a different source.
#
# Source: Harilal, G.T., Madhu, D., Ramesh, M.V. & Pullarkatt, D. (2019).
# "Towards establishing rainfall thresholds for a real-time landslide early
# warning system in Sikkim, India." Landslides, 16(12), 2395-2408.
# DOI: 10.1007/s10346-019-01244-1
RAINFALL_THRESHOLD__REGION=Sikkim (regional)
RAINFALL_THRESHOLD__EQUATION_TYPE=power_law_intensity_duration
RAINFALL_THRESHOLD__COEFFICIENT=43.26
RAINFALL_THRESHOLD__EXPONENT=-0.78
RAINFALL_THRESHOLD__DURATION_UNIT=days
RAINFALL_THRESHOLD__INTENSITY_UNIT=mm/day
RAINFALL_THRESHOLD__DURATIONS_DAYS=[1,3,5,7,10,15,20]
RAINFALL_THRESHOLD__SOURCE=Harilal, Madhu, Ramesh & Pullarkatt (2019), Landslides 16(12), 2395-2408
RAINFALL_THRESHOLD__SOURCE_DOI=10.1007/s10346-019-01244-1
RAINFALL_THRESHOLD__VERIFIED_AGAINST_PRIMARY_TEXT=false

# NER expansion, phase 1: per-state thresholds (RAINFALL_THRESHOLDS__<STATE>__*,
# note the plural "THRESHOLDS" -- a different settings field from the single
# Sikkim block above, kept separate on purpose so Sikkim's live Render config
# never needs to change). A state with no block here gets no alerts rather
# than borrowing another state's number -- see app/services/alert_engine.py.
#
# Source: Bhusan, Kundu, Goswami & Sudhakar (2014), ISPRS Int'l Archives XL-8,
# doi:10.5194/isprsarchives-XL-8-15-2014 (open access). Verified against the primary
# text: Figure 7 plots "Mean rainfall intensity (mm/h)" against "Duration (hour)" and
# the fit is I = 5.9 * D^-0.479, i.e. HOURS and mm/HOUR. The engine works in DAYS and
# mm/DAY, so the coefficient is rescaled, not copied: for a D-day window the mean
# intensity in mm/day is 24 * 5.9 * (24 D)^-0.479 = 5.9 * 24^0.521 * D^-0.479
# = 30.9 * D^-0.479. (The exponent is unchanged by the unit conversion.) Until
# 2026-09-20 this held the raw 5.9, which made every threshold 5.2x too low.
#
# Limits that remain true even now: it was fit to only 19 landslides in Guwahati CITY
# (2000-2012, hourly TRMM satellite rainfall), it is a LOWER-BOUND triggering threshold,
# and the paper's data reach ~200 hours (~8 days), so the 10/15/20-day windows below are
# extrapolation. On the rainfall stored 2026-09-21 it put all 25 of Assam's highest-risk
# zones over the line on most days, so it is NOT the rule Assam alerts with. To alert in
# Assam, DELETE this block (the IMD baseline in app/config.py then applies) and add
# "assam" to RAINFALL_ALERT_STATES. Keep it only if you want Guwahati-specific curves.
RAINFALL_THRESHOLDS__ASSAM__REGION=Assam (Guwahati)
RAINFALL_THRESHOLDS__ASSAM__EQUATION_TYPE=power_law_intensity_duration
RAINFALL_THRESHOLDS__ASSAM__COEFFICIENT=30.9
RAINFALL_THRESHOLDS__ASSAM__EXPONENT=-0.479
RAINFALL_THRESHOLDS__ASSAM__DURATION_UNIT=days
RAINFALL_THRESHOLDS__ASSAM__INTENSITY_UNIT=mm/day
RAINFALL_THRESHOLDS__ASSAM__DURATIONS_DAYS=[1,3,5,7,10,15,20]
RAINFALL_THRESHOLDS__ASSAM__SOURCE=Bhusan et al. (2014), ISPRS Int'l Archives XL-8/15, "Susceptibility mapping and estimation of rainfall threshold using space based input for assessment of landslide hazard in Guwahati city", doi:10.5194/isprsarchives-XL-8-15-2014 (coefficient rescaled from mm/h and hours to mm/day and days)
RAINFALL_THRESHOLDS__ASSAM__VERIFIED_AGAINST_PRIMARY_TEXT=true

# Mizoram: deliberately left unconfigured. No dedicated published I-D
# equation was found for Mizoram -- add a block here (or an adapted regional
# NE Himalaya equation, clearly labeled as adapted rather than Mizoram-
# specific) before Mizoram zones go live, not a copy of Sikkim's or Assam's.

# Real SMS/voice alerts (app/services/sms_alerts.py, see
# docs/sms_voice_alert_handover.md). Optional -- the app runs fine without
# these, both alert_engine.check_and_trigger() and the Broadcast composer
# fall back to their existing simulated/log-only behavior until all three
# are set. Get these from the Twilio console; never commit real values.
# Trial accounts can only send to phone numbers verified there first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI-generated one-line triage summary on citizen reports
# (app/services/triage_summary.py), via the Gemini API. Optional -- POST
# /reports works fine without it, triage_summary just stays null. Get a
# free key (no credit card needed) from Google AI Studio: aistudio.google.com
GOOGLE_API_KEY=

# Officer access key. When set, the API requires it (X-API-Key header) for every write
# action and for the two endpoints that return personal data (citizen reports, authority
# contacts). Unset = not enforced (fine for local dev). Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Scheduled rainfall refresh (POST /rainfall/refresh, called every 3 h by
# .github/workflows/rainfall-refresh.yml): how many of each state's highest-risk zones to
# refresh per run. Only states with a rainfall threshold configured above are refreshed.
RAINFALL_REFRESH_ZONES_PER_STATE=25

# States whose rainfall threshold may fire alerts/SMS (JSON list, lowercase). Default: Sikkim only.
# A state can have a threshold above for display/refresh without alerting -- add it here only once
# its threshold AND units are confirmed (Assam's Guwahati equation has an unconfirmed unit: read as
# mm/day it would put every Assam zone on alert on an ordinary monsoon day).
RAINFALL_ALERT_STATES=["sikkim"]

# Auto-resolve: an active alert closes itself once the rainfall has stayed below its threshold
# (in every duration window) for this many days in a row. Needs a full, current 20-day history.
RAINFALL_ALERT_CLEAR_DAYS=2

# "Rain worsened" updates to alerts that are already active (see README): update an
# alert (and re-text the zone's subscribers) when recent rain is at least STEP danger
# levels higher than when it was last raised/updated, at most once per MIN_HOURS per
# alert, judged over windows up to MAX_WINDOW_DAYS. The team's own choices, not from a paper.
RAINFALL_ESCALATION_STEP=0.5
RAINFALL_ESCALATION_MIN_HOURS=6
RAINFALL_ESCALATION_MAX_WINDOW_DAYS=5
